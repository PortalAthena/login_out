@{
}
 <style>
    /* Estilo base para o card (mantendo a sombra sugerida anteriormente) */
.portal-card {
    border-radius: 12px;
    border: 2px solid #dee2f6; /* Borda mais definida */
    transition: all 0.3s ease;
    background: #fff;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Garante que o fundo da imagem não escape das bordas */
}

.portal-card:hover {
    box-shadow: 0 30px 25px rgba(0,0,0,0.15); /* Sombra mais elegante */
    border-color: #0d6efd; /* Borda destaca um pouco ao passar o mouse */
}

/* Container da imagem */
    .card-img-wrapper {
        width: 100%;
        height: 170px; /* Um pouco mais alto para dar imponência */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px; /* Reduzido de 40px para 15px */
        background-color: #ffffff;
    }

         
/* Corpo do card: Fundo levemente acinzentado para separar do topo */
.card-body {
    padding: 15px;
    background-color: #fcfcfc; /* Um cinza quase branco (off-white) */
    border-top: 2px solid #eee; /* Linha de separação clara */
    flex-grow: 1;
}

/* Pequeno refinamento na tipografia */
.card-body h6 {
    letter-spacing: -0.1px;
    color: #212579;
}
 </style>
<section class="container py-4">
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex">

                <a href="@item.linkAplicacao" class="text-decoration-none w-100">

                  <div class="card portal-card h-100 shadow-sm">
    
    <div class="card-img-wrapper">
        <img src="@item.urlImagem" 
             alt="@item.tituloAplicacao" />
    </div>

    <div class="card-body text-center">
        <h6 class="fw-bold text-dark mb-1">
            @item.tituloAplicacao
        </h6>

        <p class="text-muted small mb-0">
            @item.dsc_Aplicacao
        </p>
        </div>
</div>

                </a>

            </div>
        }


    </div>
</section>

  
