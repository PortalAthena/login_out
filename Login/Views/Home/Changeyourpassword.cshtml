@model Login.Models.UsuarioModel

@{
    ViewData["Title"] = "Atualizar Dados / Senha";
}
<link href="~/lib/toastr.js/toastr.css" rel="stylesheet" />
<link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" />
<input type="hidden" value="@ViewBag.usuarioLogin" id="login" />
<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="card shadow-lg border-0" style="max-width:500px; width:100%;">
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <img src="~/img/changePassword.png"
                     alt="Alterar Senha"
                     class="img-fluid"
                     style="max-height:100px;" />
            </div>

            <h4 class="text-center mb-3">
                Olá,
                <span class="fw-bold text-primary">
                    @ViewBag.loginUsuario
                </span>
            </h4>

            <hr />
          <form asp-action="AlteraUsuario" method="post">
            <div class="mb-3">
                <label>Email</label>
                @Html.TextBoxFor(m => m.emailUsuario, new { @class = "form-control", id = "email" })
            </div>

            <div class="mb-3">
                <label>Telefone</label>
                @Html.TextBoxFor(m => m.telefoneUsuario, new { @class = "form-control", id = "telefone" })
            </div>

            <div class="mb-3">
                <label>Senha Atual</label>
                @Html.PasswordFor(m => m.senhaUsuario, new { @class = "form-control", id = "senhaAnterior" })
            </div>

            <div class="mb-3">
                <label>Nova Senha</label>
                @Html.PasswordFor(m => m.novaSenha, new { @class = "form-control", id = "senhaNova" })
            </div>
                <div class="mb-3">
                    <label>Nova Senha</label>
                    @Html.PasswordFor(m => m.ConfirmaSenha, new { @class = "form-control", id = "confirmaSenha" })
                </div>

                <div class="d-flex justify-content-end mt-5">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary me-3 px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-petroleo px-4">
                        Salvar Senha
                    </button>
              
                </div>
          </form>

        </div>
    </div>
</div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/lib/toastr.js/toastr.min.js"></script>


    <script>
            $("form").submit(function (e) {
            e.preventDefault();
            var model = @Html.Raw(Json.Serialize(Model));
            console.log(model);
            $.ajax({
                url: '@Url.Action("AlteraUsuario")',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {

                    if (!response.success) {

                             toastr.error(response.message);
                       // alert(response.message);
                        return;
                    }
                                    toastr.options = {
            "timeOut": "2000",
            "closeButton": true,
            "progressBar": true
        };

        toastr.success("Salvo com Sucesso!");

        setTimeout(function () {
            window.location.href = '/Home/Index';
        }, 2000);


                }
            });
        });

    </script>





}